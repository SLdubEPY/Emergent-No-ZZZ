{
  "name": "nozzz-venture-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "NODE_ENV=test node --test server/*.test.js src/*.test.js",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage server/*.test.js src/*.test.js",
    "check": "npm run lint && npm run test && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "supertest": "^7.2.2",
    "vite": "latest"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
