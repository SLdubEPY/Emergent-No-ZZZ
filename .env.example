# Development runs safely with ephemeral secrets and in-memory encrypted storage.
NODE_ENV=development
PORT=8787

# REQUIRED in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# REQUIRED in production. Exactly 64 hex chars. Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# Only needed when the browser origin differs from the API host.
ALLOWED_ORIGINS=

# Optional OpenAI-compatible provider. Without this, the safe built-in venture engine is used.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Set true only behind a trusted, single-hop reverse proxy.
TRUST_PROXY=false
